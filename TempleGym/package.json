{
  "name": "templegym",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "expo": "~55.0.6",
    "expo-image": "~55.0.6",
    "react": "19.2.0",
    "react-native": "0.83.2"
  }
}
