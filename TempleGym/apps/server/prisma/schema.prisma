datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum SessionType {
  PUSH
  PULL
}

enum RedemptionStatus {
  PENDING
  FULFILLED
  CANCELLED
}

// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String?
  heightCm     Int?
  weightKg     Float?
  gpsEnabled   Boolean  @default(true)
  preferMetric Boolean  @default(true)
  totalPoints  Int      @default(0)
  weeklyPoints Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  otpRequests     OtpRequest[]
  workoutSessions WorkoutSession[]
  redemptions     Redemption[]
  favourites      UserFavourite[]
}

model OtpRequest {
  id        String    @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [email], references: [email])

  @@index([email, usedAt, expiresAt])
}

model Exercise {
  id           String      @id @default(cuid())
  name         String      @unique
  category     SessionType
  subCategory  String?
  muscleGroups String[]
  emoji        String      @default("🏋️")

  workoutExercises WorkoutExercise[]
  favouritedBy     UserFavourite[]
}

model WorkoutSession {
  id              String      @id @default(cuid())
  userId          String
  type            SessionType
  startedAt       DateTime
  endedAt         DateTime
  durationMinutes Int
  pointsEarned    Int
  gpsLat          Float?
  gpsLng          Float?
  gpsVerified     Boolean     @default(false)
  volumeScore     Float       @default(0)
  weekLabel       String
  createdAt       DateTime    @default(now())

  user      User              @relation(fields: [userId], references: [id])
  exercises WorkoutExercise[]

  @@index([userId, weekLabel])
  @@index([weekLabel, pointsEarned])
}

model WorkoutExercise {
  id         String   @id @default(cuid())
  sessionId  String
  exerciseId String
  orderIndex Int
  startedAt  DateTime
  sets       Json

  session  WorkoutSession @relation(fields: [sessionId], references: [id])
  exercise Exercise       @relation(fields: [exerciseId], references: [id])
}

model ShopItem {
  id          String   @id @default(cuid())
  name        String
  description String
  pointCost   Int
  emoji       String   @default("🛍")
  sizes       String[]
  stock       Int      @default(-1)
  isActive    Boolean  @default(true)

  redemptions Redemption[]
}

model Redemption {
  id          String           @id @default(cuid())
  userId      String
  shopItemId  String
  size        String?
  pointsSpent Int
  status      RedemptionStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  user     User     @relation(fields: [userId], references: [id])
  shopItem ShopItem @relation(fields: [shopItemId], references: [id])
}

model UserFavourite {
  userId     String
  exerciseId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@id([userId, exerciseId])
}
