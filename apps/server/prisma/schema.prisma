datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

enum SessionType {
  PUSH
  PULL
  LEGS
  CARDIO
  FULL_BODY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String?
  heightCm     Int?
  weightKg     Float?
  gpsEnabled           Boolean  @default(true)
  preferMetric         Boolean  @default(true)
  leaderboardAnonymous Boolean  @default(false)
  totalPoints  Int      @default(0)
  weeklyPoints Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workoutSessions WorkoutSession[]
  gauntletEntries GauntletEntry[]
  gauntletWins GauntletCycle[]
}

model OtpRequest {
  id        String    @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, usedAt, expiresAt])
}

model Exercise {
  id           String      @id @default(cuid())
  name         String      @unique
  category     SessionType
  subCategory  String?
  muscleGroups String[]

  workoutExercises WorkoutExercise[]
  gauntletCycles GauntletCycle[]
}

model GauntletCycle {
  id  String @id @default(cuid())
  label String
  exerciseId String
  startDate DateTime
  endDate DateTime
  status String
  winnerId String?
  entries GauntletEntry[]
  createdAt DateTime @default(now())

  exercise Exercise @relation(fields: [exerciseId], references: [id])
  winner User? @relation(fields: [winnerId], references: [id])
}

model GauntletEntry {
  id String @id @default(cuid())
  cycleId String
  userId String
  weightKg Float
  reps Int
  status String @default("submitted")
  submittedAt DateTime @default(now())

  cycle GauntletCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([cycleId, userId])
}

model WorkoutSession {
  id              String      @id @default(cuid())
  userId          String
  type            SessionType
  startedAt       DateTime
  endedAt         DateTime
  durationMinutes Int
  pointsEarned    Int
  gpsLat          Float?
  gpsLng          Float?
  gpsVerified     Boolean     @default(false)
  volumeScore     Float       @default(0)
  weekLabel       String
  createdAt       DateTime    @default(now())

  user      User              @relation(fields: [userId], references: [id])
  exercises WorkoutExercise[]

  @@index([userId, weekLabel])
  @@index([weekLabel, pointsEarned])
}

model WorkoutExercise {
  id         String   @id @default(cuid())
  sessionId  String
  exerciseId String
  orderIndex Int
  startedAt  DateTime
  sets       Json

  session  WorkoutSession @relation(fields: [sessionId], references: [id])
  exercise Exercise       @relation(fields: [exerciseId], references: [id])
}

